# Docker Compose environment template
# Copy to .env and replace placeholder values before running docker compose.

DB_USERNAME=postgres
DB_PASSWORD=change_me_secure_password
JWT_SECRET=change_me_with_256_bit_base64_secret
GF_SECURITY_ADMIN_PASSWORD=change_me_grafana_admin_password

# Alerting webhook (warning/critical)
# Local default can point to a mock listener, e.g. http://host.docker.internal:5001/alerts
ALERT_WEBHOOK_URL=http://host.docker.internal:5001/alerts

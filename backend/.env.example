# Environment Variables Template
# Copy this file to .env and fill in the actual values
# ⚠️ NEVER commit .env to version control!

# Database Configuration
DB_URL=jdbc:postgresql://localhost:5432/tba_waad_system
DB_USERNAME=postgres
DB_PASSWORD=your_secure_database_password_here

# JWT Configuration
# Generate a secure 256-bit key: openssl rand -base64 32
JWT_SECRET=your_256_bit_base64_encoded_secret_here

# Email Configuration
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=587
EMAIL_USERNAME=support@alwahacare.com
EMAIL_PASSWORD=your_email_password_here
EMAIL_FROM=support@alwahacare.com
EMAIL_FROM_NAME=شركة وعد لإدارة النفقات الطبية

# Frontend URL
FRONTEND_URL=http://localhost:3000

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Security Settings
REQUIRE_EMAIL_VERIFICATION=false
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_DURATION_MINUTES=30

# Flyway Settings
FLYWAY_ENABLED=true
FLYWAY_VALIDATE=false

# Swagger (disable in production)
SWAGGER_ENABLED=false

# Logging
SHOW_SQL=false

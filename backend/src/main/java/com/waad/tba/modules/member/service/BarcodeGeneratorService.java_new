package com.waad.tba.modules.member.service;

import com.waad.tba.modules.member.entity.Member;

/**
 * واجهة خدمة توليد الباركود للأعضاء.
 */
public interface BarcodeGeneratorService {

    /**
     * التأكد من وجود التسلسلات اللازمة في قاعدة البيانات.
     */
    void ensureSequencesExist();

    /**
     * توليد باركود فريد للعضو الأصيل (Principal).
     */
    String generateForPrincipal();

    /**
     * توليد باركود بناءً على رقم البطاقة.
     */
    String generateFromCardNumber(Member member);

    /**
     * توليد باركود فريد مع معالجة التعارض والتعاون البرمجي.
     */
    String generateUniqueBarcodeForPrincipal();

    /**
     * @deprecated استخدم {@link #generateForPrincipal()} بدلاً من ذلك.
     */
    @Deprecated
    String generate();
}

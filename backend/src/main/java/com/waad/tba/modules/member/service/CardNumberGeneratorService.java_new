package com.waad.tba.modules.member.service;

import com.waad.tba.modules.member.entity.Member;

/**
 * واجهة خدمة توليد أرقام البطاقات الذكية للأعضاء.
 */
public interface CardNumberGeneratorService {

    /**
     * توليد رقم بطاقة ذكي للعضو (أصيل أو تابع).
     */
    String generateSmartCardNumber(Member member);

    /**
     * تحديد اللاحقة الخاصة بالعلاقة (للمنتفعين التابعين).
     */
    String determineRelationshipSuffix(Member member);

    /**
     * جلب كود العلاقة.
     */
    String getRelationshipCode(Member.Relationship relationship);

    /**
     * حساب تسلسل العلاقة بين الإخوة من نفس النوع.
     */
    int calculateRelationshipSequence(Member member);

    /**
     * @deprecated للطرق القديمة فقط.
     */
    @Deprecated
    String generateForPrincipalLegacy();
}

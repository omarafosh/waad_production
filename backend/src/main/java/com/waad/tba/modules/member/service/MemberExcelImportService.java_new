package com.waad.tba.modules.member.service;

import com.waad.tba.modules.member.dto.MemberImportPreviewDto;
import com.waad.tba.modules.member.dto.MemberImportResultDto;
import com.waad.tba.modules.member.entity.MemberImportLog;
import org.springframework.web.multipart.MultipartFile;

import java.io.File;
import java.util.List;
import java.util.Map;

/**
 * واجهة خدمة استيراد الأعضاء من ملفات Excel.
 */
public interface MemberExcelImportService {

    /**
     * معاينة ملف الإكسل قبل الاستيراد.
     */
    MemberImportPreviewDto parseAndPreview(MultipartFile file) throws Exception;

    /**
     * معاينة ملف الإكسل مع تعيينات مخصصة.
     */
    MemberImportPreviewDto parseAndPreview(MultipartFile file, Map<String, String> customMappings) throws Exception;

    /**
     * معاينة ملف الإكسل مع تعيينات مخصصة بتنسيق JSON ورقم صف الهيدر.
     */
    MemberImportPreviewDto parseAndPreview(MultipartFile file, String customMappingsJson, Integer headerRowNumber) throws Exception;

    /**
     * تنفيذ الاستيراد.
     */
    void executeImport(File file, String batchId, Long employerId, Long benefitPolicyId, String username, Long userId) throws Exception;

    /**
     * تنفيذ الاستيراد مع رقم صف الهيدر.
     */
    void executeImport(File file, String batchId, Long employerId, Long benefitPolicyId, Integer headerRowNumber, String username, Long userId) throws Exception;

    /**
     * تنفيذ الاستيراد مع سياسة معالجة التكرار.
     */
    void executeImport(File file, String batchId, Long employerId, Long benefitPolicyId, Integer headerRowNumber, String importPolicy, String username, Long userId) throws Exception;

    /**
     * حفظ الملف في مسار مؤقت للمعالجة الخلفية.
     */
    File saveToTempFile(MultipartFile file) throws Exception;

    /**
     * جلب سجل الاستيراد.
     */
    MemberImportLog getImportLog(String batchId);

    /**
     * جلب أخطاء الاستيراد.
     */
    List<MemberImportResultDto.ImportErrorDetailDto> getImportErrors(String batchId);
}

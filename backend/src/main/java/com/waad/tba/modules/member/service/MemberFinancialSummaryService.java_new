package com.waad.tba.modules.member.service;

import com.waad.tba.modules.member.dto.MemberFinancialSummaryDto;

/**
 * واجهة خدمة ملخص الحسابات المالية للأعضاء.
 */
public interface MemberFinancialSummaryService {

    /**
     * جلب ملخص مالي شامل للعضو يدمج بين الوثيقة، المطالبات، ونسب الاستهلاك.
     * 
     * @param memberId معرف العضو
     * @return DTO يحتوي على كافة البيانات المالية
     */
    MemberFinancialSummaryDto getFinancialSummary(Long memberId);
}

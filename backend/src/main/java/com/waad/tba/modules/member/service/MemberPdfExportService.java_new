package com.waad.tba.modules.member.service;

import com.waad.tba.modules.member.dto.MemberViewDto;
import java.io.IOException;
import java.util.List;

/**
 * واجهة خدمة تصدير موديول الأعضاء إلى ملفات PDF.
 */
public interface MemberPdfExportService {

    /**
     * توليد ملف PDF لقائمة الأعضاء مع إمكانية إضافة وصف للفلاتر.
     * 
     * @param members قائمة الأعضاء
     * @param filterDescription وصف اختياري للفلاتر المطبقة
     * @return مصفوفة بايتات للملف الناتج
     */
    byte[] generateMembersPdf(List<MemberViewDto> members, String filterDescription);

    /**
     * توليد بطاقة عضو (ID Card) لواحد كملف PDF.
     * 
     * @param member بيانات العضو
     * @return مصفوفة بايتات للملف الناتج
     */
    byte[] generateMemberCardPdf(MemberViewDto member);
}

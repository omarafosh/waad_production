package com.waad.tba.modules.rbac.service;

import com.waad.tba.modules.rbac.dto.*;
import com.waad.tba.modules.rbac.entity.User;
import org.springframework.data.domain.Page;
import org.springframework.data.domain.Pageable;

import java.util.List;

/**
 * واجهة خدمة المستخدمين (User Service Interface).
 * تهدف إلى توفير عمليات إدارة المستخدمين والصلاحيات بشكل مجرد.
 */
public interface UserService {

    /**
     * جلب كافة المستخدمين.
     */
    List<UserResponseDto> findAll();

    /**
     * جلب مستخدم بواسطة اسم المستخدم.
     */
    User getByUsername(String username);

    /**
     * جلب مستخدم بواسطة المعرف (ID).
     */
    UserResponseDto findById(Long id);

    /**
     * إنشاء مستخدم جديد.
     */
    UserResponseDto create(UserCreateDto dto);

    /**
     * تحديث بيانات مستخدم موجود.
     */
    UserResponseDto update(Long id, UserUpdateDto dto);

    /**
     * حذف مستخدم (حذف ناعم أو كامل حسب الإعدادات).
     */
    void delete(Long id);

    /**
     * البحث عن المستخدمين باستخدام نص بحث.
     */
    List<UserResponseDto> search(String query);

    /**
     * جلب المستخدمين التابعين لمزود خدمة معين.
     */
    List<UserResponseDto> findByProviderId(Long providerId);

    /**
     * جلب المستخدمين (المزودين) غير المرتبطين حالياً.
     */
    List<UserResponseDto> findUnassignedProviders();

    /**
     * جلب المستخدمين بنظام الصفحات (Pagination).
     */
    Page<UserResponseDto> findAllPaginated(Pageable pageable);

    /**
     * تعيين أدوار (Roles) لمستخدم.
     */
    UserResponseDto assignRoles(Long userId, AssignRolesDto dto);

    /**
     * سحب أدوار من مستخدم.
     */
    UserResponseDto removeRoles(Long userId, AssignRolesDto dto);

    /**
     * البحث عن مستخدم بواسطة الاسم أو البريد الإلكتروني.
     */
    User findByUsernameOrEmail(String identifier);

    /**
     * تفعيل أو تعطيل حالة المستخدم.
     */
    UserResponseDto toggleStatus(Long id);
}

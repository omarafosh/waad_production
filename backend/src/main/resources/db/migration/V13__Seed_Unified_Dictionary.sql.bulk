-- Create sequence for medical service codes
DO $$
BEGIN
    IF NOT EXISTS (SELECT FROM pg_class WHERE relname = 'medical_service_code_seq') THEN
        CREATE SEQUENCE medical_service_code_seq START 1000;
    END IF;
END $$;


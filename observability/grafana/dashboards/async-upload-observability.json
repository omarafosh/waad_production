{
  "id": null,
  "uid": "tba-async-upload",
  "title": "TBA Async Upload Observability",
  "tags": ["tba", "async-upload"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "panels": [
    {
      "type": "timeseries",
      "title": "Async Jobs by Status (5m increase)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum by (status) (increase(tba_claims_attachments_async_jobs_total[5m]))",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "File Success Rate (5m)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 90 },
              { "color": "green", "value": 97 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "100 * sum(rate(tba_claims_attachments_async_files_total{status=\"success\"}[5m])) / clamp_min(sum(rate(tba_claims_attachments_async_files_total{status=~\"success|failed\"}[5m])), 0.001)",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Files Outcome Throughput (/s)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum by (status) (rate(tba_claims_attachments_async_files_total{status=~\"success|failed\"}[5m]))",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Average Job Duration (seconds)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "rate(tba_claims_attachments_async_job_duration_seconds_sum[5m]) / clamp_min(rate(tba_claims_attachments_async_job_duration_seconds_count[5m]), 0.001)",
          "legendFormat": "avg_duration_s",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Attachment Type Distribution (/m)",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "sum by (attachment_type) (increase(tba_claims_attachments_async_file_type_total[1m]))",
          "legendFormat": "{{attachment_type}}",
          "refId": "A"
        }
      ]
    }
  ],
  "templating": { "list": [] },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  }
}
